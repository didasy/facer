# Copy to `.env` and adjust. All values optional — app defaults apply.
# Note: docker-compose.yml sets its own fallbacks for some vars
# (VERIFY_THRESHOLD 0.60, ATTRIB_THRESHOLD 0.6, EYE_CLOSED_THRESHOLD 0.6);
# explicit values here take precedence over those fallbacks.

MODEL_DIR=./models

# Face-ROI blur gate (Laplacian variance, raw scale)
BLUR_THRESHOLD=25.0
BLUR_SCORE_MAX=250.0
FACE_PAD_RATIO=0.25

# RetinaFace-R34 detection
DET_THRESHOLD=0.5
DET_INPUT_SIZE=640

# EdgeFace verification (cosine similarity gate)
VERIFY_THRESHOLD=0.40

# FaceAttribNet attributes + MiniFASNetV2 liveness
ATTRIB_THRESHOLD=0.5
EYE_CLOSED_THRESHOLD=0.5
MINIFAS_SCALE=2.7

# Max in-flight POST /api/v1/verify per worker (overflow → 429)
MAX_QUEUED_REQUESTS=10
