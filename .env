# =============================================================================
# Biometric Verification API (RetinaFace-R34 + EdgeFace Base) — environment config
# =============================================================================
# Docker Compose reads this file for ${VAR:-default} interpolation.
# Only vars referenced as ${...} in docker-compose.yml flow into the container
# automatically. Others documented below with accurate wiring status.
# NOTE: no inline trailing comments — every KEY=value line must stand alone,
# because Compose treats "VALUE # comment" as part of the value.
# =============================================================================

# --- Server runtime -----------------------------------------------------------
# NOTE: compose sets these literally (PORT=8000, WORKERS=2) and the Dockerfile
# CMD hardcodes `uvicorn ... --port 8000`. Changing the values here has NO
# effect until compose/CMD are wired to ${PORT} / ${WORKERS}.
# HTTP port. Compose maps "8000:8000"; healthcheck hits :8000/health.
PORT=8000
# Uvicorn worker count. Informational until CMD uses it.
WORKERS=2

# --- Model locations ----------------------------------------------------------
# Wired: compose overrides to /app/models (mounted ro from ./models).
# Local default in app/main.py is ./models.
MODEL_DIR=/app/models
# Model filenames are fixed in app/main.py, not configurable:
# retinaface_r34.onnx, edgeface_base.onnx, minifasnetv2.onnx, face_attrib_net.onnx
# Fetch them via: ./models/download.sh [--force]

# --- Threading / math libs ----------------------------------------------------
# Wired: passed through compose `environment`.
# OpenMP threads (OpenCV, ONNX Runtime).
OMP_NUM_THREADS=2
# MKL threads (numpy).
MKL_NUM_THREADS=2

# --- Face-ROI blur gate -------------------------------------------------------
# Wired via ${VAR:-default} in compose; read by app/main.py via os.getenv.
# Calibrated 2026-09-15 on Lena @512px:
# sharp ROI ~553 / slight-blur ~53 / heavy-blur 4-16.
# Face-ROI Laplacian-variance floor (raw scale); below this = blurry.
BLUR_THRESHOLD=25.0
# Raw variance mapping to blur_score 0.0 (sharp); raw 0 maps to 1.0 (max blur).
BLUR_SCORE_MAX=250.0
# Padding around detected face box for the blur ROI, as fraction of box size.
FACE_PAD_RATIO=0.25

# --- RetinaFace-R34 detection ---------------------------------------------------
# Wired via ${VAR:-default} in compose; read by app/main.py via os.getenv.
# Face confidence threshold (also reused as NMS score threshold).
DET_THRESHOLD=0.5
# Max-side cap for detector input (downscale-only, aspect preserved).
# Larger = slower, better small-face recall.
DET_INPUT_SIZE=640

# --- EdgeFace verification ----------------------------------------------------
# Wired via ${VAR:-default} in compose; read by app/main.py via os.getenv.
# Cosine-similarity threshold, EdgeFace Base 512D (>= value = verified).
VERIFY_THRESHOLD=0.40

# --- FaceAttribNet attributes + MiniFASNetV2 liveness ---------------------------
# Wired via ${VAR:-default} in compose; read by app/main.py via os.getenv.
# Per-head probability gate for eyeglasses / mask / sunglasses (independent
# binary heads, never argmax). Threshold each attribute separately.
ATTRIB_THRESHOLD=0.5
# Mean(left_eye_open, right_eye_open) below this = eye_closed_detected=True.
EYE_CLOSED_THRESHOLD=0.5
# Crop expand factor for the MiniFASNetV2 face region (upstream default 2.7).
MINIFAS_SCALE=2.7

# --- Concurrency gate -----------------------------------------------------------
# Wired via ${VAR:-default} in compose; read by app/main.py via os.getenv.
# Max in-flight POST /api/v1/verify requests per Python process.
# Over-limit requests get immediate HTTP 429 with Retry-After: 1.
MAX_QUEUED_REQUESTS=10

# --- Hardcoded in app/main.py (NOT env-wired; listed for completeness) --------
# Uncomment in code AND wire via os.getenv before use.
# Values below equal current hardcoded behavior.
# 45/255: luminance_score below this = too dark (is_dark=True).
# LUMINANCE_DARK_MIN=0.1765
# 225/255: luminance_score above this = too bright (is_dark=True).
# LUMINANCE_DARK_MAX=0.8824
# cv2.dnn.NMSBoxes IoU threshold in detect_faces().
# NMS_IOU_THRESHOLD=0.4
# Hat/veil pending dedicated model: OcclusionResult returns null for both.
# No thresholds exist yet; schema fields default to None.
